---
import { withBase } from '../../lib/format';

const { data } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="facsimile">
  {
    data.pages && (
      <ol class="facsimile-pages">
        {data.pages.map((p: string, i: number) => (
          <li>
            <img
              src={withBase(base, p)}
              alt={`Page ${i + 1} of “${data.title}”`}
              loading={i > 0 ? 'lazy' : 'eager'}
            />
          </li>
        ))}
      </ol>
    )
  }
  {
    data.pdf && (
      <p class="download">
        <a href={withBase(base, data.pdf)}>download the original PDF</a>
      </p>
    )
  }
  <slot />
</div>
