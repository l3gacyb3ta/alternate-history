---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Flag from '../components/Flag.astro';
import { catalogNumber, displayDate, withBase } from '../lib/format';

const base = import.meta.env.BASE_URL;
const artifacts = (await getCollection('artifacts')).sort((a, b) =>
  a.data.date.localeCompare(b.data.date)
);
---

<Base>
  <h1>Alternate History - Name Pending :P</h1>
  <p class="foreword">
    Documents recovered (written, designed, etc.) by <a href="https://arcades.agency/">Arcade Wise</a>.
  </p>

  <h2>The Archives</h2>
  <p>
    The papers below come out of a twentieth and twenty first century that took a different road
    after the Second World War.
    The <a href="https://en.wikipedia.org/wiki/Berlin_Blockade">Berlin Blockade</a> succeeded, and
    the GDR retained control of Berlin. 
		France remade itself in May '68, and in Lyon in 1974 founded the Union sociale with newly liberated
		Portugal. The Europäischer Bund, formed in Frankfurt in 2002, grew out of a newly libertarian German
		Free State (the former GDR), still stinging from the loss of Berlin to radical activists.
  </p>

  <table class="catalog">
    <thead>
      <tr>
        <th scope="col">No.</th>
        <th scope="col">Date</th>
        <th scope="col">Kind</th>
        <th scope="col">Polities</th>
        <th scope="col">Title</th>
      </tr>
    </thead>
    <tbody>
      {
        artifacts.map((a, i) => (
          <tr>
            <td class="no">{catalogNumber(i + 1)}</td>
            <td class="worlddate">{displayDate(a.data.date, a.data.dateDisplay)}</td>
            <td class="kind">{a.data.kind}</td>
            <td class="polities">{a.data.flags.map((code) => <Flag code={code} />)}</td>
            <td>
              <a href={withBase(base, `/artifacts/${a.id}/`)}>{a.data.title}</a>
              {a.data.sample && ' (sample)'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>
