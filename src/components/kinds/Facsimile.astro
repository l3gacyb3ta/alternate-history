---
import { withBase } from '../../lib/format';

const { data } = Astro.props;
const base = import.meta.env.BASE_URL;
const pdfUrl = data.pdf ? withBase(base, data.pdf) : null;
const hasPages = (data.pages?.length ?? 0) > 0;
---

<div class="facsimile">
  {
    pdfUrl && (
      <object
        class={`facsimile-viewer${hasPages ? ' has-fallback' : ''}`}
        data={`${pdfUrl}#view=FitH`}
        type="application/pdf"
        aria-label={`PDF of “${data.title}”`}
      >
        <p>
          This browser will not show the PDF inline —
          <a href={pdfUrl}>download it</a> instead.
        </p>
      </object>
    )
  }
  {
    hasPages && (
      <ol class={`facsimile-pages${pdfUrl ? ' is-fallback' : ''}`}>
        {data.pages.map((p: string, i: number) => (
          <li>
            <img
              src={withBase(base, p)}
              alt={`Page ${i + 1} of “${data.title}”`}
              loading={i > 0 ? 'lazy' : 'eager'}
            />
          </li>
        ))}
      </ol>
    )
  }
  {
    pdfUrl && (
      <p class="download">
        <a href={pdfUrl}>download the original PDF</a>
      </p>
    )
  }
  <slot />
</div>
