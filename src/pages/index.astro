---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { catalogNumber, displayDate, withBase } from '../lib/format';

const base = import.meta.env.BASE_URL;
const artifacts = (await getCollection('artifacts')).sort((a, b) =>
  a.data.date.localeCompare(b.data.date)
);
---

<Base>
  <h1>Alternate Histories</h1>
  <p class="foreword">
    Documents recovered from timelines that never happened — written, designed,
    and misfiled by Arcade Wise.
  </p>

  <h2>The Collection: Restored</h2>
  <p>
    The papers below come out of a twentieth century that took a different road
    after the Second World War. Germany parted into a Federal Republic and a
    Deutscher Freistaat and stayed parted; France remade itself in 1968; and
    when Europe went looking for unity it found two of them — the Union sociale,
    signed at Lyon in 1974, and the Europäischer Bund, signed at Frankfurt in
    2002. The documents are presented as found. Where the archivist has
    something to add, it is added below the document, in the archivist's voice,
    and marked as such.
  </p>

  <table class="catalog">
    <thead>
      <tr>
        <th scope="col">No.</th>
        <th scope="col">Date</th>
        <th scope="col">Kind</th>
        <th scope="col">Title</th>
      </tr>
    </thead>
    <tbody>
      {
        artifacts.map((a, i) => (
          <tr>
            <td class="no">{catalogNumber(i + 1)}</td>
            <td class="worlddate">{displayDate(a.data.date, a.data.dateDisplay)}</td>
            <td class="kind">{a.data.kind}</td>
            <td>
              <a href={withBase(base, `/artifacts/${a.id}/`)}>{a.data.title}</a>
              {a.data.sample && ' (sample)'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>
